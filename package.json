{
  "name": "hugo-blox-academic-cv-starter",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "Academic CV starter template for Hugo Blox with Tailwind CSS v4",
  "scripts": {
    "dev": "node scripts/online-publications/sync.mjs && hugo server --disableFastRender",
    "build": "node scripts/online-publications/sync.mjs && hugo --minify && pnpm run pagefind",
    "pagefind": "pagefind --site public",
    "papers:sync": "node scripts/online-publications/sync.mjs",
    "papers:online-test": "node --test scripts/online-publications/sync.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.10",
    "pagefind": "^1.4.0",
    "preact": "^10.27.2",
    "tailwindcss": "^4.1.12"
  }
}

